# Copy to .env.local and fill in your values. Do not commit .env.local.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Brevo (for app emails: application received, welcome, admin notifications)
BREVO_API_KEY=your-brevo-api-key
# Must match a verified sender in Brevo (e.g. info@pbkleadership.org.za)
BREVO_FROM_EMAIL=info@yourdomain.com
EMAIL_FROM_NAME=PBK Memorial Leadership Institute

# Optional: Resend as fallback if Brevo fails
RESEND_API_KEY=

# Support and admin notifications. Defaults to the institute inbox when unset.
SUPPORT_EMAIL=info@pbkleadership.org.za
ADMIN_NOTIFY_EMAIL=info@pbkleadership.org.za

# Student banking details shown on the enrol page and in payment emails.
# These match the official Capitec Business notice. If a host still has the
# previous Absa account (PBK Memorial t/a Kriska Solutions, 4109771651),
# replace or remove those variables so students are not paid into the old account.
BANK_NAME=Capitec Business
BANK_ACCOUNT_NAME=PBK Memorial Management and Leadership Institute
BANK_ACCOUNT_NUMBER=105 554 2612
BANK_BRANCH_CODE=450105
BANK_ACCOUNT_TYPE=Current
BANK_REFERENCE=Student Name

# App URL (used in email links; use https for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
